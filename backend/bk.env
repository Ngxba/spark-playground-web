# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/spark_playground
SQLALCHEMY_ECHO=False

# Spark Cluster (use Docker service names)
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_URL=http://spark-master:8080
SPARK_SHUFFLE_PARTITIONS=4
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Spark Event Logging (use Docker service names)
SPARK_EVENT_LOG_DIR=s3a://spark-events/spark-history/
SPARK_HISTORY_SERVER_URL=http://localhost:18080
# SPARK_ACTIVE_UI_URL=http://localhost:4040  # Not needed, using History Server

# MinIO (S3-compatible storage for event logs - use Docker service name)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# PySpark JARs directory
PYSPARK_JARS_DIR=pyspark_jars
